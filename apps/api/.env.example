# Server
NODE_ENV=development
# 4001 matches the web dev proxy (apps/web/vite.config.ts) and apps/mobile/.env.example
PORT=4001
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://farm:farm@localhost:5432/farm?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Seed (local/dev only)
SEED_PASSWORD=ChangeMe123!

# Storage: local | mongodb (GridFS) | r2 (Cloudflare S3 API for receipt photos)
STORAGE_DRIVER=local
MONGODB_URI=mongodb://localhost:27017/farm
MONGODB_BUCKET=farm-files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Push notifications
# Paste the full Firebase service-account JSON as a single line (or leave empty to log only).
# Native device tokens use FCM HTTP v1; Expo Go tokens (ExponentPushToken[…]) use Expo Push API (no FCM needed).
FCM_SERVICE_ACCOUNT_JSON=
# SMS is CRITICAL / overdue-HIGH only. Cap is per farm per Nepal month.
SMS_MONTHLY_CAP=40
# Twilio (optional). When set, CRITICAL SMS goes out; otherwise SMS is logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required on Vercel (Nest @Cron is skipped there). Same value → GitHub secret NOTIFICATION_CRON_SECRET.
# Body: { "secret": "…" } or header: x-cron-secret: …
# See docs/deployment.md. Generate with: openssl rand -base64 32
NOTIFICATION_CRON_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /v1/jobs/nightly.
# /v1/jobs/* also accepts NOTIFICATION_CRON_SECRET, so both may hold the same value.
CRON_SECRET=
