# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://farm:farm@localhost:5432/farm?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Seed (local/dev only)
SEED_PASSWORD=ChangeMe123!

# Storage: local | mongodb (GridFS) | r2 (Cloudflare S3 API for receipt photos)
STORAGE_DRIVER=local
MONGODB_URI=mongodb://localhost:27017/farm
MONGODB_BUCKET=farm-files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Push notifications (Firebase). Leave empty to log instead of send.
FCM_SERVICE_ACCOUNT_JSON=
# SMS is CRITICAL / overdue-HIGH only. Cap is per farm per Nepal month.
SMS_MONTHLY_CAP=40
