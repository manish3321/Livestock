  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, deathAt])
}

/// Highest-consequence feature. Withheld milk in a cooperative tank
/// rejects the whole collection. Rows stack; the later endDate wins.
model MilkWithhold {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  animalId      String    @db.Uuid
  healthEventId String?   @db.Uuid
  medicationId  String?   @db.Uuid
  drugName      String
  startDate     DateTime
  endDate       DateTime
  reason        String?
  clearedAt     DateTime?
  createdAt     DateTime  @default(now())

  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  healthEvent HealthRecord?  @relation(fields: [healthEventId], references: [id], onDelete: SetNull)
  medication  InventoryItem? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([animalId, endDate])
  @@index([farmId, endDate])
}

model MeatWithhold {
  id            String   @id @default(uuid()) @db.Uuid
  farmId        String   @db.Uuid
  animalId      String   @db.Uuid
  healthEventId String?  @db.Uuid
  medicationId  String?  @db.Uuid
  drugName      String
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())

  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  healthEvent HealthRecord?  @relation(fields: [healthEventId], references: [id], onDelete: SetNull)
  medication  InventoryItem? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([animalId, endDate])
}

// ---------------------------------------------------------------------------
// Breeding
