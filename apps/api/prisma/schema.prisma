generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a non-pooled connection; pgbouncer transaction mode
  // cannot hold the advisory lock Prisma Migrate takes.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  WORKER
  VET
  COOP
}

/** HOUSEHOLD = simple UI defaults; COMMERCIAL = full dairy/finance depth. */
enum FarmMode {
  HOUSEHOLD
  COMMERCIAL
}

/**
 * Which livestock surface is primary. INDIVIDUAL makes the tagged Animal the
 * unit of record (needed for lactation, breeding and profit per animal);
 * BATCH makes counted HerdBatch primary. Both remain available either way.
 */
enum LivestockTrackingMode {
  INDIVIDUAL
  BATCH
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  /// Voice/IVR is the default channel when the user asked for literacy support.
  literacySupport Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships FarmMembership[]
  sessions    RefreshSession[]
  devices     Device[]
  auditEvents AuditEvent[]
  assignedTasks Task[] @relation("TaskAssignee")
  notificationLogs NotificationLog[]
  notificationPreferences NotificationPreference[]
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  location  String?
  currency  String   @default("NPR")
  timezone  String   @default("Asia/Kathmandu")
  mode      FarmMode @default(HOUSEHOLD)
  livestockTrackingMode LivestockTrackingMode @default(INDIVIDUAL)
  /// Local clock hours the shed actually milks. Scan-to-record opens in
  /// milking mode at these times without being asked.
  morningMilkingHour Int @default(5)
  eveningMilkingHour Int @default(17)
  /// Advertised coop rate. Never use this in a profit figure.
  milkPriceNpr      Decimal  @default(62) @db.Decimal(8, 2)
  /// Weighted mean of the last 3 CooperativePayment periods.
  effectivePriceNpr Decimal? @db.Decimal(8, 2)
  labourMonthlyNpr  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      FarmMembership[]
  animals          Animal[]
  weightRecords    WeightRecord[]
  animalGroups     AnimalGroup[]
  groupMortality   GroupMortalityEvent[]
  fishBatches      FishBatch[]
  waterQualityLogs WaterQualityLog[]
  fishSamplings    FishSampling[]
  expenses         Expense[]
  revenues         Revenue[]
  inventoryItems   InventoryItem[]
  restockRequests  RestockRequest[]
  healthRecords    HealthRecord[]
  breedingRecords  BreedingRecord[]
  productionEntries ProductionEntry[]
  auditEvents      AuditEvent[]
  changeLog        ChangeLogEntry[]
  mutations        SyncMutationRecord[]
  herdBatches      HerdBatch[]
  batchIllness     BatchIllnessEvent[]
  batchMortality   BatchMortalityEvent[]
  batchWaterLogs   BatchWaterQualityLog[]
  batchSamplings   BatchSamplingEvent[]
  batchHarvests    BatchHarvestEvent[]
  batchFeeds       BatchFeedEvent[]
  expenseBudgets   ExpenseBudget[]
  recurringExpenses RecurringExpense[]
  stockMovements   StockMovement[]
  notificationLogs NotificationLog[]
  notificationPreferences NotificationPreference[]
  feedLogs         FeedLog[]
  heatLogs         HeatLog[]
  heatEvents       HeatEvent[]
  semenStraws      SemenStraw[]
  breedingServices BreedingService[]
  pregnancyChecks  PregnancyCheck[]
  calvingEvents    CalvingEvent[]
  colostrumFeedings ColostrumFeeding[]
  expenseAllocations ExpenseAllocation[]
  animalStatusHistory AnimalStatusHistory[]
  tasks            Task[]
  herdNumberSequences HerdNumberSequence[]
  tagSequenceBlocks TagSequenceBlock[]
  animalPhotos     AnimalPhoto[]
  animalTags       AnimalTag[]
  animalMarkers    AnimalMarker[]
  milkRounds       MilkRound[]
  milkTanks        MilkTank[]
  milkDeliveries   MilkDelivery[]
  paymentStatements PaymentStatement[]
  productionRevisions ProductionRevision[]
  recordingRounds  RecordingRound[]
  scanEvents       ScanEvent[]
  milkWithholds    MilkWithhold[]
  meatWithholds    MeatWithhold[]
  vaccineProtocols VaccineProtocol[]
  healthEvents     HealthEvent[]
  vaccinationRecords VaccinationRecord[]
  udderChecks      UdderCheck[]
  mortalityRecords MortalityRecord[]
  stockLots        StockLot[]
  feedRecords      FeedRecord[]
  dailyMetrics     DailyMetric[]
  coopPayments     CooperativePayment[]
  pens             Pen[]
  heatObservations HeatObservation[]
  syncEnrollments  SyncEnrollment[]
  reproStageHistory ReproStageHistory[]
  reminderRules    ReminderRule[]
}

model FarmMembership {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  farmId String @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
  @@index([farmId])
}

/// Physical walking order of the farm. The breeding board never sorts by name.
model Pen {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @db.Uuid
  name      String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals Animal[]

  @@unique([farmId, name])
  @@index([farmId, sortOrder])
}

// ---------------------------------------------------------------------------
// Sessions & devices
// ---------------------------------------------------------------------------

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  platform     String    @default("web")
  deviceName   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id         String   @id
  userId     String   @db.Uuid
  platform   String   @default("android")
  fcmToken   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  farmId     String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  requestId  String?
  createdAt  DateTime @default(now())

  farm Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([farmId, createdAt])
}

// ---------------------------------------------------------------------------
// Domain: Animals (reference syncable entity for the foundation)
// ---------------------------------------------------------------------------

enum Species {
  BUFFALO
  COW
  PIG
  GOAT
}

/// Status is a single point-in-time state. Pregnancy is deliberately NOT here:
/// a buffalo is routinely lactating and pregnant at the same time, so it lives
/// on Animal.isPregnant as a flag.
enum AnimalStatus {
  GROWING
  HEIFER
  ACTIVE
  SICK
  QUARANTINE
  DRY
  LACTATING
  CULLED
  SOLD
  DEAD
}

/// Derived reproductive stage. Never entered by hand — first matching rule wins.
enum ReproStage {
  CALF
  HEIFER_READY
  VOLUNTARY_WAIT
  AWAITING_HEAT
  IN_HEAT
  SERVED_UNCONFIRMED
  PREGNANCY_CHECK_DUE
  PREGNANT_EARLY
  PREGNANT_DRYOFF_DUE
  DRY_PREGNANT
  CALVING_IMMINENT
  FRESH
  ANESTRUS_SUSPECTED
  REPEAT_BREEDER
  UNDER_PROTOCOL
  DO_NOT_BREED
  NOT_BREEDING
}

/// Reproductive constants per species. Buffalo and cattle differ on every one
/// of these, and a 305-day lactation is a Holstein number that is simply wrong
/// for Nepal — so nothing here may be hardcoded in application code.
///
/// Reference data rather than farm data: gestation length is biology, not farm
/// policy, and a missing per-farm row would break breeding for a new farm.
model SpeciesConfig {
  id                         String   @id @default(uuid()) @db.Uuid
  species                    Species  @unique
  /// Days from conception to birth.
  gestationDays              Int
  /// Expected length of a lactation. NOT 305 — that is a Holstein figure.
  lactationDays              Int
  /// Deliberate wait after calving before she may be served again.
  voluntaryWaitingDays       Int
  estrusCycleDays            Int
  ageFirstServiceMonths      Int
  /// Earliest a pregnancy diagnosis can be trusted.
  pregnancyCheckEarliestDays Int
  targetCalvingIntervalDays  Int
  dryOffDaysBeforeCalving    Int
  /// Days past EDD before CALVING_LATE fires. Buffalo 10, cattle 7.
  gestationVarianceDays      Int      @default(7)
  minWeightFirstServiceKg    Int
  /// Hours after standing heat when the service window opens / closes.
  serviceWindowStartHours    Int      @default(12)
  serviceWindowEndHours      Int      @default(18)
  /// Buffalo only: clock hour to prompt a pre-dawn heat check. Null = skip.
  silentHeatCheckHour        Int?
  /// Normal butterfat band for this species in Nepal. Buffalo 6.5–8.0, cattle 3.5–4.5.
  fatMinPercent              Decimal  @default(3.5) @db.Decimal(4, 2)
  fatMaxPercent              Decimal  @default(4.5) @db.Decimal(4, 2)
  /// Normal rectal temperature band. Application code reads these; it must not hardcode 38.5.
  tempMinC                   Decimal  @default(37.5) @db.Decimal(4, 1)
  tempMaxC                   Decimal  @default(39.5) @db.Decimal(4, 1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

enum Gender {
  FEMALE
  MALE
}

enum AnimalSource {
  PURCHASED
  BORN
  GIFTED
  TRANSFERRED
}

model Animal {
  id             String        @id @default(uuid()) @db.Uuid
  farmId         String        @db.Uuid
  tag            String
  /// Human identifier printed large on the tag: B42, C08. Never reused.
  herdNumber     String?
  name           String?
  species        Species
  breed          String
  dateOfBirth    DateTime?
  /// Nepali farmers rarely know the exact DOB of a purchased animal.
  /// Registration is never blocked on DOB, so age-driven calculations must
  /// show a marker when the date behind them is a guess.
  dobIsEstimated Boolean       @default(false)
  /// Fallback when DOB is unknown: age in months when acquired, from which a
  /// synthetic dateOfBirth is computed.
  ageAtAcquisitionMonths Int?
  gender         Gender
  color          String?
  source         AnimalSource?
  motherTag      String?
  purchaseDate   DateTime?
  purchaseCost   Decimal?      @db.Decimal(12, 2)
  sellerName     String?
  status         AnimalStatus  @default(ACTIVE)
  /// Pregnancy is a flag, not a status — she can be lactating and pregnant
  /// at once. Making these mutually exclusive is a schema bug.
  isPregnant     Boolean       @default(false)
  pregnancyConfirmedDate DateTime?
  expectedCalvingDate    DateTime?
  /// Which lactation she is on; 0 means she has never calved.
  lactationNumber Int          @default(0)
  lactationStartDate DateTime?
  /// Seeded from SpeciesConfig.lactationDays at registration.
  expectedLactationDays Int?
  expectedDryOff     DateTime?
  /// Calf missed the colostrum absorption window (~6h).
  highRiskFPT        Boolean       @default(false)
  chronicMastitis    Boolean       @default(false)
  birthWeightKg      Decimal?      @db.Decimal(5, 2)
  /// Female of a mixed-sex twin pair — likely infertile.
  isFreemartinSuspect Boolean      @default(false)
  /// Fractional breed makeup, e.g. {"murrah":0.75,"local":0.25}. Sums to 1.0.
  breedComposition Json?
  /** When true, animal can be used as a breeding parent. */
  breedingStock  Boolean       @default(true)
  shed           String?
  penId          String?       @db.Uuid
  /// Walking order inside the pen. Board sorts by pen.sortOrder, then this.
  seqNo          Int           @default(0)
  distinguishingMarks String?
  photoStorageKey String?
  photoUrl       String?
  damId          String?        @db.Uuid
  sireId         String?        @db.Uuid
  notes          String?
  /// Derived. Stored so the watch screen and nightly job can query without recomputing.
  reproStage     ReproStage    @default(NOT_BREEDING)
  reproStageSince DateTime?
  reproStageComputedAt DateTime?
  doNotBreed     Boolean       @default(false)
  doNotBreedReason String?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  farm       Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pen        Pen?              @relation(fields: [penId], references: [id], onDelete: SetNull)
  dam        Animal?          @relation("AnimalDam", fields: [damId], references: [id], onDelete: SetNull)
  sire       Animal?          @relation("AnimalSire", fields: [sireId], references: [id], onDelete: SetNull)
  damOffspring Animal[]       @relation("AnimalDam")
  sireOffspring Animal[]      @relation("AnimalSire")
  weights    WeightRecord[]
  health     HealthRecord[]
  healthEvents HealthEvent[]
  vaccinationRecords VaccinationRecord[]
  feedRecords    FeedRecord[]
  dailyMetrics   DailyMetric[]
  breeding   BreedingRecord[]
  production ProductionEntry[]
  expenses   Expense[]
  revenues   Revenue[]
  feedLogs   FeedLog[]
  heatLogs   HeatLog[]
  heatEvents HeatEvent[]
  breedingServices BreedingService[]
  pregnancyChecks PregnancyCheck[]
  calvingEvents CalvingEvent[] @relation("CalvingDam")
  calfRecord CalfRecord?
  colostrumFeedings ColostrumFeeding[]
  expenseAllocations ExpenseAllocation[]
  calvingRecords BreedingRecord[] @relation("BreedingOffspring")
  statusHistory  AnimalStatusHistory[]
  tasks          Task[]
  photos         AnimalPhoto[]
  tags           AnimalTag[]
  markers        AnimalMarker[]
  milkWithholds  MilkWithhold[]
  meatWithholds  MeatWithhold[]
  udderChecks    UdderCheck[]
  mortalityRecord MortalityRecord?
  heatObservations HeatObservation[]
  syncEnrollments  SyncEnrollment[]
  reproStageHistory ReproStageHistory[]

  @@unique([farmId, tag])
  @@unique([farmId, herdNumber])
  @@index([farmId, updatedAt])
  @@index([farmId, species])
  @@index([farmId, status])
  @@index([farmId, breedingStock])
  @@index([farmId, isPregnant])
  @@index([farmId, shed])
  @@index([penId])
  @@index([farmId, seqNo])
  @@index([damId])
  @@index([sireId])
  @@index([farmId, reproStage])
}

/// Append-only stage transitions. daysInPrevious is how long she was in fromStage.
model ReproStageHistory {
  id             String      @id @default(uuid()) @db.Uuid
  animalId       String      @db.Uuid
  farmId         String      @db.Uuid
  fromStage      ReproStage?
  toStage        ReproStage
  enteredAt      DateTime    @default(now())
  daysInPrevious Int?
  /// CALVING / SERVICE / PREG_CONFIRMED / NIGHTLY / HEAT / PROTOCOL / STATUS / REGISTERED
  trigger        String?

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, enteredAt(sort: Desc)])
  @@index([farmId, toStage, enteredAt])
}

/// Seeded reminder catalogue. farmId null = system default; a farm row with
/// the same code overrides it. Offsets that depend on species are resolved
/// from SpeciesConfig at fire time — they are not copied into this table.
model ReminderRule {
  id                   String      @id @default(uuid()) @db.Uuid
  farmId               String?     @db.Uuid
  code                 String
  taskType             TaskType
  triggerStage         ReproStage?
  triggerEvent         String?
  species              Species[]   @default([])
  offsetDays           Int         @default(0)
  offsetHours          Int         @default(0)
  fireAtHour           Int?
  repeatEveryDays      Int?
  repeatUntilStage     ReproStage?
  maxRepeats           Int?
  priority             TaskPriority
  channels             String[]
  escalateAfterMinutes Int?
  escalateToRole       Role?
  titleEn              String
  titleNp              String
  bodyEn               String?
  bodyNp               String?
  actionKeys           String[]
  active               Boolean     @default(true)
  isSystemDefault      Boolean     @default(false)

  farm Farm? @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, active])
  @@index([code])
}

/// Append-only record of every status change. A status is never overwritten
/// silently: "why is she marked DRY" has to be answerable months later.
model AnimalStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  farmId     String        @db.Uuid
  animalId   String        @db.Uuid
  /// Null for the row written at registration.
  fromStatus AnimalStatus?
  toStatus   AnimalStatus
  reason     String?
  changedAt  DateTime      @default(now())
  changedBy  String?       @db.Uuid
  deviceId   String?
  createdAt  DateTime      @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, animalId, changedAt])
  @@index([farmId, changedAt])
}

model WeightRecord {
  id         String   @id @default(uuid()) @db.Uuid
  farmId     String   @db.Uuid
  animalId   String   @db.Uuid
  weightKg   Decimal  @db.Decimal(8, 2)
  /** Body condition score 1–5. */
  bcs        Int?
  recordedAt DateTime
  notes      String?
  createdAt  DateTime @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, recordedAt])
  @@index([farmId])
}

/// Per-farm, per-species sequence so B42 is never issued twice, including
/// after the animal is sold or dies. Offline phones take a reserved block.
model HerdNumberSequence {
  id          String  @id @default(uuid()) @db.Uuid
  farmId      String  @db.Uuid
  species     Species
  nextNumber  Int     @default(1)
  /// High-water mark of numbers handed to offline devices. Blocks of 100.
  reservedThrough Int @default(0)

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, species])
}

/// Offline ID allocation. Blocks of 100 per device per species.
/// Without this, two offline phones produce the same tag number.
model TagSequenceBlock {
  id          String    @id @default(uuid()) @db.Uuid
  farmId      String    @db.Uuid
  species     Species
  deviceId    String
  rangeStart  Int
  rangeEnd    Int
  nextValue   Int
  issuedAt    DateTime  @default(now())
  exhaustedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, species, deviceId])
}

model AnimalPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  farmId     String   @db.Uuid
  animalId   String   @db.Uuid
  storageKey String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, sortOrder])
}

enum AnimalTagReason {
  ISSUED
  LOST
  DAMAGED
  ILLEGIBLE
  REPLACED
}

/// A short number belongs to the animal for life. Replacing a muddy tag
/// reprints B42; the old printed tag still resolves and says it was replaced.
model AnimalTag {
  id         String          @id @default(uuid()) @db.Uuid
  farmId     String          @db.Uuid
  animalId   String          @db.Uuid
  herdNumber String
  fullTag    String
  reason     AnimalTagReason @default(ISSUED)
  nfcUid     String?
  uhfEpc     String?
  replacedAt DateTime?
  createdAt  DateTime        @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, herdNumber])
  @@index([animalId, createdAt])
}

enum MarkerColor {
  RED
  YELLOW
  BLUE
  GREEN
  WHITE
}

enum MarkerMeaning {
  MILK_WITHHOLD
  DRY
  CALVING_SOON
  IN_HEAT
  TREATMENT
}

/// Physical coloured band. Completing a place/remove task requires a scan so
/// the record matches what is on the ear. Red never means anything except
/// "milk must not be sold".
model AnimalMarker {
  id              String        @id @default(uuid()) @db.Uuid
  farmId          String        @db.Uuid
  animalId        String        @db.Uuid
  color           MarkerColor
  meaning         MarkerMeaning
  placedAt        DateTime      @default(now())
  placedById      String?       @db.Uuid
  placedByScan    Boolean       @default(false)
  validUntil      DateTime?
  removedAt       DateTime?
  removedById     String?       @db.Uuid
  removedByScan   Boolean       @default(false)
  createdAt       DateTime      @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, animalId, removedAt])
  @@index([farmId, color, removedAt])
}

// ---------------------------------------------------------------------------
// Groups (poultry flocks) — count-based
// ---------------------------------------------------------------------------

enum PoultryType {
  LAYER
  BROILER
  DUCK
}

enum GroupHealthStatus {
  HEALTHY
  WATCH
  SICK
}

model AnimalGroup {
  id           String            @id @default(uuid()) @db.Uuid
  farmId       String            @db.Uuid
  name         String
  poultryType  PoultryType
  breed        String
  initialCount Int
  currentCount Int
  startedAt    DateTime
  healthStatus GroupHealthStatus @default(HEALTHY)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  farm       Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  mortality  GroupMortalityEvent[]
  health     HealthRecord[]
  production ProductionEntry[]

  @@index([farmId])
}

model GroupMortalityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @db.Uuid
  groupId   String   @db.Uuid
  count     Int
  reason    String?
  occurredAt DateTime
  createdAt DateTime @default(now())

  farm  Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  group AnimalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, occurredAt])
}

// ---------------------------------------------------------------------------
// Fish batches — estimate-based
// ---------------------------------------------------------------------------

model FishBatch {
  id             String    @id @default(uuid()) @db.Uuid
  farmId         String    @db.Uuid
  name           String
  species        String
  stockingDate   DateTime
  estimatedCount Int
  avgWeightGrams Decimal   @db.Decimal(8, 2)
  notes          String?
  harvestedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  farm         Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  waterQuality WaterQualityLog[]
  samplings    FishSampling[]
  production   ProductionEntry[]

  @@index([farmId])
}

model WaterQualityLog {
  id           String   @id @default(uuid()) @db.Uuid
  farmId       String   @db.Uuid
  batchId      String   @db.Uuid
  recordedAt   DateTime
  temperatureC Decimal? @db.Decimal(5, 2)
  ph           Decimal? @db.Decimal(4, 2)
  dissolvedO2  Decimal? @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime @default(now())

  farm  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batch FishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, recordedAt])
}

model FishSampling {
  id              String   @id @default(uuid()) @db.Uuid
  farmId          String   @db.Uuid
  batchId         String   @db.Uuid
  sampledAt       DateTime
  sampleCount     Int
  totalWeightGrams Decimal @db.Decimal(10, 2)
  estimatedCount  Int
  avgWeightGrams  Decimal  @db.Decimal(8, 2)
  notes           String?
  createdAt       DateTime @default(now())

  farm  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batch FishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, sampledAt])
}

// ---------------------------------------------------------------------------
// Herd batches — category + age-range count tracking (livestock/poultry/fish)
// ---------------------------------------------------------------------------

enum HerdBatchKind {
  LIVESTOCK
  POULTRY
  FISH
}

model HerdBatch {
