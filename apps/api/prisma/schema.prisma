model HealthRecord {
  id          String           @id @default(uuid()) @db.Uuid
  farmId      String           @db.Uuid
  type        HealthRecordType
  title       String
  animalId    String?          @db.Uuid
  groupId     String?          @db.Uuid
  herdBatchId String?          @db.Uuid
  /** Optional cost of this health event (NPR). */
  cost        Decimal?         @db.Decimal(12, 2)
  medicine    String?
  dosage      String?
  method      String?
  vetName     String?
  outcome     HealthOutcome?
  followUpAt  DateTime?
