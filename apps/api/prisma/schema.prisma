  symptoms             Symptom[] @default([])
  temperatureC         Decimal?          @db.Decimal(4, 1)
  severity             Severity?
  provisionalDiagnosis String?
  finalDiagnosis       String?
  diagnosedBy          DiagnosedBy       @default(FARMER)
  vetName              String?
  vetPhone             String?
  outcome              TreatmentOutcome  @default(ONGOING)
  recoveredOn          DateTime?
  totalCostNpr         Decimal?          @db.Decimal(10, 2)
  taskId               String?           @db.Uuid
  notes                String?
  createdAt            DateTime          @default(now())
  deletedAt            DateTime?
  deviceId             String?
  healthRecordId       String?           @db.Uuid

  farm        Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccination VaccinationRecord?
  medications MedicationAdministration[]

  @@index([animalId, eventAt])
  @@index([farmId, outcome])
}

model VaccinationRecord {
