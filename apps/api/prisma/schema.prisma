enum MatingType {
  NATURAL
  AI
}

enum PregnancyStatus {
  OPEN
  PREGNANT
  CONFIRMED
  DELIVERED
  FAILED
}

model BreedingRecord {
  id              String          @id @default(uuid()) @db.Uuid
  farmId          String          @db.Uuid
  motherId        String          @db.Uuid
  matingType      MatingType
  fatherTagOrAi   String?
  matingDate      DateTime
  dueDate         DateTime
