  SWELLING
  PAIN
  HARDNESS
  ASYMMETRY
  NONE
}

enum MastitisClass {
  HEALTHY
  SUBCLINICAL
  CLINICAL
}

enum Quarter {
  LF
  RF
  LR
  RR
}

model UdderCheck {
  id               String         @id @default(uuid()) @db.Uuid
  animalId         String         @db.Uuid
  farmId           String         @db.Uuid
  checkDate        DateTime       @db.Date
  method           UdderMethod
  quarterScores    Json
  sccThousand      Int?
  appearance       MilkAppearance @default(NORMAL)
  signs            UdderSign[]    @default([])
  classification   MastitisClass
  affectedQuarters Quarter[]      @default([])
