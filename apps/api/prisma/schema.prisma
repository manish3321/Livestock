model HeatEvent {
  id         String         @id @default(uuid()) @db.Uuid
  animalId   String         @db.Uuid
  farmId     String         @db.Uuid
  observedAt DateTime
  intensity  HeatIntensity
  signs      HeatSign[]
  observerId String?        @db.Uuid
  wasBred    Boolean        @default(false)
  notes      String?
  createdAt  DateTime       @default(now())
  deviceId   String?

  farm     Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal   Animal            @relation(fields: [animalId], references: [id], onDelete: Cascade)
  services BreedingService[]

  @@index([animalId, observedAt])
  @@index([farmId, observedAt])
}

/// Looked-and-saw-nothing is data. It drives anestrus escalation.
model HeatObservation {
  id          String    @id @default(uuid()) @db.Uuid
  animalId    String    @db.Uuid
  farmId      String    @db.Uuid
  observedAt  DateTime
  observed    Boolean
  heatEventId String?   @db.Uuid
  observerId  String?   @db.Uuid
  taskId      String?   @db.Uuid
  createdAt   DateTime  @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, observedAt(sort: Desc)])
  @@index([farmId, observedAt])
}

model SemenStraw {
  id              String   @id @default(uuid()) @db.Uuid
  farmId          String   @db.Uuid
  strawCode       String
  bullName        String
  bullBreed       String
  bullIdOfficial  String?
  supplier        String?
