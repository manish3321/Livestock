  qtyRemaining    Int      @default(0)
  costPerStrawNpr Decimal  @db.Decimal(10, 2)
  sireMilkIndex   Decimal? @db.Decimal(8, 2)

  farm     Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  services BreedingService[]

  @@unique([farmId, strawCode])
}

model SyncProtocol {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  nameEn            String
  nameNp            String
  species           Species[]
  requiresCyclicity Boolean   @default(true)
  totalDays         Int
  steps             Json
  notesEn           String?
  notesNp           String?
  active            Boolean   @default(true)
  estimatedCostNpr  Decimal   @default(0) @db.Decimal(10, 2)

  enrollments SyncEnrollment[]
}

model SyncEnrollment {
  id                 String    @id @default(uuid()) @db.Uuid
  animalId           String    @db.Uuid
  farmId             String    @db.Uuid
  protocolId         String    @db.Uuid
  startDate          DateTime  @db.Date
  vetName            String?
  vetPhone           String?
  status             String    @default("ACTIVE")
  brokenAtStep       Int?
  brokenReason       String?
  aiDate             DateTime? @db.Date
  serviceId          String?   @db.Uuid
  estimatedCostNpr   Decimal?  @db.Decimal(10, 2)
  startedInLowSeason Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  farm     Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal   Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  protocol SyncProtocol @relation(fields: [protocolId], references: [id], onDelete: Restrict)

  @@index([animalId, startDate(sort: Desc)])
  @@index([farmId, status])
}

model BreedingService {
  id              String        @id @default(uuid()) @db.Uuid
  animalId        String        @db.Uuid
  farmId          String        @db.Uuid
  serviceDate     DateTime
  heatEventId     String?       @db.Uuid
  method          ServiceMethod
  sireId          String?       @db.Uuid
  strawId         String?       @db.Uuid
  technicianName  String?
  technicianPhone String?
  costNpr         Decimal?      @db.Decimal(10, 2)
  /// nth service this lactation. >= 3 raises REPEAT_BREEDER.
  serviceNo       Int           @default(1)
  result          ServiceResult @default(PENDING)
  provisionalEdd  DateTime?
  createdAt       DateTime      @default(now())
  deviceId        String?

  farm             Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal           Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  heatEvent        HeatEvent?       @relation(fields: [heatEventId], references: [id], onDelete: SetNull)
  straw            SemenStraw?      @relation(fields: [strawId], references: [id], onDelete: SetNull)
  pregnancyChecks  PregnancyCheck[]
  calvingEvents    CalvingEvent[]

  @@index([animalId, serviceDate])
  @@index([farmId, result])
}

model PregnancyCheck {
  id                    String          @id @default(uuid()) @db.Uuid
  serviceId             String          @db.Uuid
  animalId              String          @db.Uuid
  farmId                String          @db.Uuid
  checkDate             DateTime
  method                PregCheckMethod
  result                PregCheckResult
  estimatedDaysPregnant Int?
  examinerName          String?
  costNpr               Decimal?        @db.Decimal(10, 2)

  farm    Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal  Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  service BreedingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([animalId, checkDate])
}

model CalvingEvent {
  id                        String                @id @default(uuid()) @db.Uuid
  damId                     String                @db.Uuid
  farmId                    String                @db.Uuid
  serviceId                 String?               @db.Uuid
  calvingAt                 DateTime
  gestationDaysActual       Int?
  difficulty                CalvingDifficulty     @default(EASY)
  complications             CalvingComplication[]
  placentaExpelledWithin12h Boolean?
  outcome                   CalvingOutcome
  damConditionPost          DamCondition          @default(NORMAL)
  assistedBy                String?
  interventionCostNpr       Decimal?              @db.Decimal(10, 2)
  calvingIntervalDays       Int?
  daysOpenDays              Int?
  notes                     String?
  createdAt                 DateTime              @default(now())
  deviceId                  String?

  farm   Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  dam    Animal       @relation("CalvingDam", fields: [damId], references: [id], onDelete: Cascade)
  service BreedingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  calves CalfRecord[]

  @@index([damId, calvingAt])
  @@index([farmId, calvingAt])
}

model CalfRecord {
  id                  String     @id @default(uuid()) @db.Uuid
  calvingId           String     @db.Uuid
  animalId            String?    @unique @db.Uuid
  sex                 Gender
  birthWeightKg       Decimal?   @db.Decimal(5, 2)
  vigour              CalfVigour @default(NORMAL)
  defects             String?
  photoId             String?
  isFreemartinSuspect Boolean    @default(false)

  calving    CalvingEvent       @relation(fields: [calvingId], references: [id], onDelete: Cascade)
  animal     Animal?            @relation(fields: [animalId], references: [id], onDelete: SetNull)
  feedings   ColostrumFeeding[]
}

model ColostrumFeeding {
  id              String           @id @default(uuid()) @db.Uuid
  calfRecordId    String           @db.Uuid
  animalId        String?          @db.Uuid
  farmId          String           @db.Uuid
  taskId          String?          @db.Uuid
  fedAt           DateTime
  hoursAfterBirth Decimal          @db.Decimal(5, 2)
  volumeLitres    Decimal          @db.Decimal(5, 2)
  source          ColostrumSource
  method          ColostrumMethod
  quality         ColostrumQuality @default(NOT_ASSESSED)
  heatTreated     Boolean          @default(false)
  fedById         String?          @db.Uuid

  farm       Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  calfRecord CalfRecord @relation(fields: [calfRecordId], references: [id], onDelete: Cascade)
  animal     Animal?    @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([calfRecordId, fedAt])
}

// ---------------------------------------------------------------------------
// Production tracking
// ---------------------------------------------------------------------------

enum ProductionType {
  MILK
  EGGS
  FISH
}

enum QualityGrade {
  A
  B
  C
  PREMIUM
  STANDARD
}

enum MilkSession {
  MORNING
  EVENING
  MIDDAY
}

enum MilkDestination {
  SOLD
  CALF
  HOUSEHOLD
  DISCARDED
}

enum MilkRoundStatus {
  OPEN
  FINISHED
}

enum RecordingMode {
  MILKING
  VACCINATION
  TREATMENT
  WEIGHING
  HEALTH_CHECK
  MARKER_PLACEMENT
  BROWSE
}

enum RoundStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum CobResult {
  NOT_TESTED
  PASS
  FAIL
}

enum UnrecordedReason {
  NOT_MILKED
  FORGOT
  RECORDED
}

/// One milking round. Mode is chosen once; every scan in the shed writes
/// into this round. Finishing asks about anyone still missing — a missing
/// record silently wrecks every average and every profit figure.
model MilkRound {
  id          String          @id @default(uuid()) @db.Uuid
  farmId      String          @db.Uuid
  session     MilkSession
  roundDate   DateTime
  status      MilkRoundStatus @default(OPEN)
  startedById String?         @db.Uuid
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  farm     Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  entries  ProductionEntry[]
  tank     MilkTank?
  skipped         MilkRoundSkip[]
  recordingRound  RecordingRound?

  @@unique([farmId, roundDate, session])
  @@index([farmId, status, roundDate])
}

model MilkRoundSkip {
  id        String           @id @default(uuid()) @db.Uuid
  roundId   String           @db.Uuid
  animalId  String           @db.Uuid
  reason    UnrecordedReason
  createdAt DateTime         @default(now())

  round MilkRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, animalId])
}

/// Per-session tank. Expected litres are the sum of milk marked SOLD —
/// computed, never typed. Variance is the daily honesty check.
model MilkTank {
  id             String    @id @default(uuid()) @db.Uuid
  farmId         String    @db.Uuid
  roundId        String    @unique @db.Uuid
  expectedLitres Decimal   @db.Decimal(12, 2)
  actualLitres   Decimal?  @db.Decimal(12, 2)
  temperatureC   Decimal?  @db.Decimal(5, 2)
  compositeFat   Decimal?  @db.Decimal(5, 2)
  compositeSnf   Decimal?  @db.Decimal(5, 2)
  cobResult      CobResult @default(NOT_TESTED)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  farm     Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  round    MilkRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  delivery MilkDelivery?
}

model MilkDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  farmId          String   @db.Uuid
  tankId          String   @unique @db.Uuid
  litresSent      Decimal  @db.Decimal(12, 2)
  litresAccepted  Decimal? @db.Decimal(12, 2)
  litresRejected  Decimal? @db.Decimal(12, 2)
  rejectReason    String?
  centreFat       Decimal? @db.Decimal(5, 2)
  centreSnf       Decimal? @db.Decimal(5, 2)
  lactometer      Decimal? @db.Decimal(6, 3)
  centreScc       Int?
  receiptNumber     String?
  receiptUrl        String?
  receiptStorageKey String?
  expectedValue     Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  farm Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  tank MilkTank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@map("MilkRoundDelivery")
}

/// Fortnightly cooperative statement. Effective price = netPaid / litres.
/// That number — typically 10–25% below the headline rate — is what every
/// profit-per-animal figure must use.
model PaymentStatement {
  id             String   @id @default(uuid()) @db.Uuid
  farmId         String   @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  litres         Decimal  @db.Decimal(12, 2)
  baseRate       Decimal  @db.Decimal(12, 2)
  fatBonus       Decimal  @default(0) @db.Decimal(12, 2)
  snfBonus       Decimal  @default(0) @db.Decimal(12, 2)
  sccPenalty     Decimal  @default(0) @db.Decimal(12, 2)
  coolingCharge  Decimal  @default(0) @db.Decimal(12, 2)
  transport      Decimal  @default(0) @db.Decimal(12, 2)
  membership     Decimal  @default(0) @db.Decimal(12, 2)
  feedCredit     Decimal  @default(0) @db.Decimal(12, 2)
  netPaid        Decimal  @db.Decimal(12, 2)
  effectivePrice Decimal  @db.Decimal(12, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, periodEnd])
}

model ProductionEntry {
  id          String         @id @default(uuid()) @db.Uuid
  farmId      String         @db.Uuid
  type        ProductionType
  entryDate   DateTime
  quantity    Decimal        @db.Decimal(12, 2)
  unit        String
  quality     QualityGrade?
  animalId    String?        @db.Uuid
  groupId     String?        @db.Uuid
  batchId     String?        @db.Uuid
  herdBatchId String?        @db.Uuid
  milkRoundId String?        @db.Uuid
  session     MilkSession?
  destination MilkDestination?
  milkerName  String?
  appearance  MilkAppearance?
  fatPercent  Decimal?       @db.Decimal(5, 2)
  snfPercent  Decimal?       @db.Decimal(5, 2)
  proteinPercent Decimal?    @db.Decimal(5, 2)
  lactosePercent Decimal?    @db.Decimal(5, 2)
  scc         Int?
  collectionMethod CollectionMethod?
  udderFlag   Boolean        @default(false)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  farm      Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal    Animal?      @relation(fields: [animalId], references: [id], onDelete: SetNull)
  group     AnimalGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  batch     FishBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  herdBatch HerdBatch?   @relation(fields: [herdBatchId], references: [id], onDelete: SetNull)
  milkRound MilkRound?   @relation(fields: [milkRoundId], references: [id], onDelete: SetNull)
  revisions ProductionRevision[]

  @@index([farmId, entryDate])
  @@index([farmId, type])
  @@index([herdBatchId])
  @@index([milkRoundId])
  @@index([farmId, animalId, entryDate, session])
}

/// Corrections keep the original figure. Nothing is overwritten silently.
model ProductionRevision {
  id               String   @id @default(uuid()) @db.Uuid
  farmId           String   @db.Uuid
  entryId          String   @db.Uuid
  previousQuantity Decimal  @db.Decimal(12, 2)
  newQuantity      Decimal  @db.Decimal(12, 2)
  reason           String?
  changedById      String?  @db.Uuid
  createdAt        DateTime @default(now())

  farm  Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  entry ProductionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

model NotificationLog {
  id             String    @id @default(uuid()) @db.Uuid
  farmId         String    @db.Uuid
  userId         String?   @db.Uuid
  taskId         String?   @db.Uuid
  channel        String    @default("PUSH")
  subject        String    @default("")
  body           String    @default("")
  sent           Boolean   @default(false)
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  escalatedTo    String?
  costNpr        Decimal?  @db.Decimal(6, 2)
  payload        Json?
  createdAt      DateTime  @default(now())

  farm Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([farmId, createdAt])
  @@index([userId, sentAt])
  @@index([taskId])
}

model NotificationPreference {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  farmId   String   @db.Uuid
  taskType TaskType
  push     Boolean  @default(true)
  sms      Boolean  @default(false)
  voice    Boolean  @default(false)
  muted    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, taskType])
}

// ---------------------------------------------------------------------------
// Offline sync
// ---------------------------------------------------------------------------

enum SyncMutationStatus {
  APPLIED
  DUPLICATE
  CONFLICT
  FAILED
}

/// Idempotency ledger: one row per client mutation ever received.
model SyncMutationRecord {
  clientMutationId String             @id @db.Uuid
  farmId           String             @db.Uuid
  userId           String             @db.Uuid
  deviceId         String
  entityType       String
  entityId         String
  op               String
  status           SyncMutationStatus
  serverVersion    Int?
  error            String?
  createdAt        DateTime           @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
}

// ---------------------------------------------------------------------------
// Domain: Tasks — the farmer's work queue
// ---------------------------------------------------------------------------

enum TaskType {
  VACCINATION_DUE
  MEDICATION_DOSE
  COLOSTRUM_FEED
  CALVING_WATCH
  HEAT_WATCH
  SILENT_HEAT_CHECK
  SERVICE_WINDOW
  PREGNANCY_CHECK
  DRY_OFF
  POSTPARTUM_CHECK
  REPEAT_BREEDER
  VET_URGENT
  MILK_WITHHOLD_END
  STOCK_REORDER
  LOT_EXPIRING
  MISSING_PRODUCTION
  YIELD_DROP
  STOCK_RECONCILE
  TANK_VARIANCE
  APPLY_MARKER
  REMOVE_MARKER
  RETAG_REQUIRED
  TREATMENT_FOLLOWUP
  EXPENSE_APPROVAL
  UNPAID_REVENUE
  SYNC_INJECTION
  SYNC_AI
  ANESTRUS_MINERAL
  ANESTRUS_VET
  ANESTRUS_DECISION
  FEED_TRANSITION
  PROTOCOL_BROKEN
  CALF_HEALTH_CHECK
  CYCLING_UNBRED
  PD_STALLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum TaskStatus {
  PENDING
  DONE
  SNOOZED
  DISMISSED
  EXPIRED
  SUPERSEDED
}

/// AUTO tasks come from the nightly generators and must be idempotent.
enum TaskSource {
  AUTO
  MANUAL
}

/// Dismissing is a real answer, not a shrug — the reason is required so the
/// generator can learn that the farmer already did it offline.
enum TaskDismissReason {
  NOT_NEEDED
  ALREADY_DONE_OFFLINE
  ANIMAL_SOLD
  WRONG_ANIMAL
  OTHER
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  farmId        String       @db.Uuid
  animalId      String?      @db.Uuid
  batchId       String?      @db.Uuid
  type          TaskType
  titleEn       String
  titleNp       String
  dueAt         DateTime
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(PENDING)
  assignedToId  String?      @db.Uuid
  source        TaskSource   @default(AUTO)
  /// What produced this task, so completing it can open the right form.
  sourceRefType String?
  sourceRefId   String?      @db.Uuid
  /// Snoozing is capped at 3 times; after that the task is non-snoozable.
  snoozedUntil  DateTime?
  snoozeCount   Int          @default(0)
  completedAt   DateTime?
  completedById String?      @db.Uuid
  dismissReason TaskDismissReason?
  dismissNote   String?
  supersededBy  String?      @db.Uuid
  deviceId      String?
  createdBy     String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  farm       Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal     Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)
  batch      HerdBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([farmId, status, dueAt])
  @@index([farmId, animalId, status])
  @@index([farmId, assignedToId, status])
  @@index([farmId, priority, dueAt])
}

/// Monotonic per-server change feed consumed by /sync/pull.
model ChangeLogEntry {
  seq        BigInt    @id @default(autoincrement())
  farmId     String    @db.Uuid
  entityType String
  entityId   String
  version    Int
  deletedAt  DateTime?
  data       Json?
  createdAt  DateTime  @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, seq])
}

/// Mode chosen once at the start of a shed walk. Milk rows still live on
/// ProductionEntry + MilkRound so existing tank/delivery stays intact.
model RecordingRound {
  id                String         @id @default(uuid()) @db.Uuid
  farmId            String         @db.Uuid
  mode              RecordingMode
  session           MilkSession?
  date              DateTime
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  status            RoundStatus    @default(ACTIVE)
  operatorId        String         @db.Uuid
  contextItemId     String?
  contextLotId      String?
  contextDose       String?
  expectedCount     Int?
  recordedCount     Int            @default(0)
  skippedCount      Int            @default(0)
  totalLitres       Decimal?       @db.Decimal(9, 2)
  durationSeconds   Int?
  secondsPerAnimal  Decimal?       @db.Decimal(6, 2)
  milkRoundId       String?        @unique @db.Uuid
  deviceId          String?

  farm      Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  milkRound MilkRound?     @relation(fields: [milkRoundId], references: [id], onDelete: SetNull)
  skips     RoundSkip[]
  scans     ScanEvent[]

  @@index([farmId, date, mode])
  @@index([farmId, status])
}

model RoundSkip {
  id       String @id @default(uuid()) @db.Uuid
  roundId  String @db.Uuid
  animalId String @db.Uuid
  reason   String
  note     String?

  round RecordingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, animalId])
}

model ScanEvent {
  id         String   @id @default(uuid()) @db.Uuid
  farmId     String   @db.Uuid
  roundId    String?  @db.Uuid
  animalId   String?  @db.Uuid
  rawPayload String?
  success    Boolean
  failReason String?
  method     String
  scannedAt  DateTime @default(now())
  deviceId   String?

  farm  Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  round RecordingRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([farmId, scannedAt])
  @@index([animalId, scannedAt])
}
