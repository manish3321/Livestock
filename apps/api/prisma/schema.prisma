  chronicFlag      Boolean        @default(false)
  checkedById      String?        @db.Uuid
  createdAt        DateTime       @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, checkDate])
}

enum CauseCategory {
  DISEASE
  INJURY
  CALVING_COMPLICATION
  PREDATION
  POISONING
  UNKNOWN
}

enum DisposalMethod {
  BURIED
  BURNED
  RENDERED
  SOLD_FOR_MEAT
}

model MortalityRecord {
  id                   String          @id @default(uuid()) @db.Uuid
  animalId             String          @unique @db.Uuid
  farmId               String          @db.Uuid
  deathAt              DateTime
  causeCategory        CauseCategory
  suspectedDisease     String?
  postMortemDone       Boolean         @default(false)
  postMortemFindings   String?
