# Nest API origin (no trailing slash). Paths in the client already include /v1/...
# Emulator → host machine: http://10.0.2.2:4001
# Physical device / Expo Go → PC LAN IP (same host as Metro QR, e.g. 192.168.1.10):
#   http://192.168.1.10:4001
#
# The app auto-picks: Android emulator → 10.0.2.2; physical phone → Metro LAN host.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4001

# Web app for Desktop (pixel-perfect) mode
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:5173
