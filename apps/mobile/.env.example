# Nest API origin (no trailing slash). Paths in the client already include /v1/...
# Emulator → host machine: http://10.0.2.2:4001
# Physical device → your LAN IP: http://192.168.x.x:4001
EXPO_PUBLIC_API_URL=http://localhost:4001

# Web app origin for Desktop (pixel-perfect) mode
EXPO_PUBLIC_WEB_URL=http://localhost:5173
